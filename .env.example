# Application Configuration
PORT=6801
PROJECT_NAME="AI CCTV Video Intelligence & Summarization System"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-jwt-key-change-in-production"
ENVIRONMENT="development"

# Database (PostgreSQL with pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cctv_intelligence
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cctv_intelligence

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Vector Embeddings
EMBEDDING_DIMENSION=384
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"

# VLM & Detection Config
DETECTION_CONFIDENCE_THRESHOLD=0.45
CAPTION_INTERVAL_SECONDS=10
VIDEO_STORAGE_DIR="./storage/videos"
THUMBNAIL_STORAGE_DIR="./storage/thumbnails"

# NVIDIA VSS Agent Settings
NVIDIA_API_KEY=""
NVIDIA_VSS_URL="https://integrate.api.nvidia.com/v1/chat/completions"
NVIDIA_VSS_MODEL="meta/llama-3.2-11b-vision-instruct"

# Notifications / Webhooks
WEBHOOK_ALERT_URL="http://localhost:6801/api/v1/alerts/webhook-demo"
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

# TP-Link VIGI VMS / NVR & Cloudflare Tunnel Configuration
VIGI_VMS_HOST="127.0.0.1"
VIGI_VMS_PORT=8554
VIGI_VMS_USERNAME="admin"
VIGI_VMS_PASSWORD="Gt@102020"
VIGI_VMS_RTSP_URL="rtsp://admin:Gt%40102020@127.0.0.1:8554/live/1/1/avm"
CLOUDFLARE_HOSTNAME="nvr1.goodwindco.in"

